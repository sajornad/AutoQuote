# --- LiveKit Cloud (cloud.livekit.io > Settings > API Keys) ---
LIVEKIT_URL=wss://tu-proyecto.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# ID del trunk SIP de salida (empieza con ST_), ver README paso 3
SIP_OUTBOUND_TRUNK_ID=

# --- Modelos ---
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
DEEPGRAM_API_KEY=
ELEVEN_API_KEY=
# Voz de ElevenLabs (elige una en español en elevenlabs.io > Voices y copia su ID)
ELEVEN_VOICE_ID=

# --- Google Sheets ---
GOOGLE_SERVICE_ACCOUNT_FILE=service-account.json
GOOGLE_SHEET_ID=
# Opcional: nombre de la pestaña (por defecto la primera)
GOOGLE_SHEET_TAB=

# --- Personaje ---
NOMBRE_VENDEDOR=Sofía
NOMBRE_EMPRESA=3GO Video

# --- Reglas de marcado ---
PREFIJO_PAIS=+57
ZONA_HORARIA=America/Bogota
HORA_INICIO=8
HORA_FIN=18
HORA_FIN_SABADO=15
PAUSA_ENTRE_LLAMADAS=10
MAX_INTENTOS=3
